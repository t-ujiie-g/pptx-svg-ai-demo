# ========================================
# Gemini バックエンド選択
# ========================================
# Vertex AI を使う場合: TRUE（GOOGLE_CLOUD_PROJECT を設定、gcloud auth application-default login 済みであること）
# Gemini API (AI Studio) を使う場合: FALSE（GOOGLE_API_KEY を設定）
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- Gemini API (AI Studio) を使う場合 ---
# https://aistudio.google.com/app/apikey で取得
GOOGLE_API_KEY=your-gemini-api-key

# --- Vertex AI を使う場合 ---
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# ========================================
# Backend — 使用モデル
# ========================================
# モデルは「3つのティア」で管理します。各エージェントはデフォルトでこの
# ティアを参照する（config.py の agent_*_model = "tier:high|mid|lite"）ため、
# 下の3行を書き換えるだけで全エージェントに反映されます。
#   high → pptx生成 (重い推論)
#   mid  → root / search / critic / リトライ
#   lite → style抽出 / entity抽出 (軽量)
MODEL_TIER_HIGH=gemini-3.1-pro-preview
MODEL_TIER_MID=gemini-3.5-flash
MODEL_TIER_LITE=gemini-3.1-flash-lite-preview

# 全エージェントを 3.5 Flash に揃えたい場合は、上の3行をすべて
# gemini-3.5-flash にしてください。

# (任意) 特定エージェントだけティアを無視して個別指定したい場合に上書き。
# 値は "tier:high|mid|lite" か、具体的なモデルID。未設定ならティアに従う。
#AGENT_ROOT_MODEL=tier:mid
#AGENT_PPTX_MODEL=tier:high
#AGENT_STYLE_MODEL=tier:lite
#AGENT_CRITIC_MODEL=tier:mid
#AGENT_PRESERVATION_MODEL=tier:lite

# ========================================
# Backend — サーバー
# ========================================
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
# CORS許可オリジン（カンマ区切り）
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# ========================================
# Frontend
# ========================================
VITE_API_BASE_URL=http://localhost:8000
